{
  "name": "split",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --experimental-sqlite server/index.mjs\" \"vite --host 127.0.0.1 --port 5174\"",
    "build": "tsc --noEmit && vite build",
